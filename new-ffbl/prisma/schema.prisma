  report_content  String?
  prospect1       String?     @db.VarChar
  prospect2       String?     @db.VarChar
  prospect3       String?     @db.VarChar
  prospect4       String?     @db.VarChar
  prospect5       String?     @db.VarChar
  prospect6       String?     @db.VarChar
  prospect7       String?     @db.VarChar
  prospect8       String?     @db.VarChar
  prospect9       String?     @db.VarChar
  prospect10      String?     @db.VarChar
  catch           String?     @db.VarChar
  first           String?     @db.VarChar
  second          String?     @db.VarChar
  third           String?     @db.VarChar
  short           String?     @db.VarChar
  of1             String?     @db.VarChar
  of2             String?     @db.VarChar
  of3             String?     @db.VarChar
  util1           String?     @db.VarChar
  util2           String?     @db.VarChar
  sp1             String?     @db.VarChar
  sp2             String?     @db.VarChar
  sp3             String?     @db.VarChar
  rp1             String?     @db.VarChar
  rp2             String?     @db.VarChar
  rp3             String?     @db.VarChar
  p1              String?     @db.VarChar
  p2              String?     @db.VarChar
  bench1          String?     @db.VarChar
  bench2          String?     @db.VarChar
  bench3          String?     @db.VarChar
  bench4          String?     @db.VarChar
  bench5          String?     @db.VarChar
  bench6          String?     @db.VarChar
  bench7          String?     @db.VarChar
  pyr1            Int?
  pyr2            Int?
  pyr3            Int?
  pyr4            Int?
  pyr5            Int?
  pyr6            Int?
  pyr7            Int?
  pyr8            Int?
  pyr9            Int?
  pyr10           Int?
  past_prospect1  String?     @db.VarChar
  past_prospect2  String?     @db.VarChar
  past_prospect3  String?     @db.VarChar
  past_prospect4  String?     @db.VarChar
  past_prospect5  String?     @db.VarChar
  past_prospect6  String?     @db.VarChar
  past_prospect7  String?     @db.VarChar
  past_prospect8  String?     @db.VarChar
  past_prospect9  String?     @db.VarChar
  past_prospect10 String?     @db.VarChar
  pcurrent1       String?     @db.VarChar
  pcurrent2       String?     @db.VarChar
  pcurrent3       String?     @db.VarChar
  pcurrent4       String?     @db.VarChar
  pcurrent5       String?     @db.VarChar
  pcurrent6       String?     @db.VarChar
  pcurrent7       String?     @db.VarChar
  pcurrent8       String?     @db.VarChar
  pcurrent9       String?     @db.VarChar
  pcurrent10      String?     @db.VarChar
  dpyr1           Int?
  dpyr2           Int?
  dpyr3           Int?
  dpyr4           Int?
  dpyr5           Int?
  dpyr6           Int?
  dpyr7           Int?
  dpyr8           Int?
  dpyr9           Int?
  dpyr10          Int?
  draft_pick1     String?     @db.VarChar
  draft_pick2     String?     @db.VarChar
  draft_pick3     String?     @db.VarChar
  draft_pick4     String?     @db.VarChar
  draft_pick5     String?     @db.VarChar
  draft_pick6     String?     @db.VarChar
  draft_pick7     String?     @db.VarChar
  draft_pick8     String?     @db.VarChar
  draft_pick9     String?     @db.VarChar
  draft_pick10    String?     @db.VarChar
  dpcurrent1      String?     @db.VarChar
  dpcurrent2      String?     @db.VarChar
  dpcurrent3      String?     @db.VarChar
  dpcurrent4      String?     @db.VarChar
  dpcurrent5      String?     @db.VarChar
  dpcurrent6      String?     @db.VarChar
  dpcurrent7      String?     @db.VarChar
  dpcurrent8      String?     @db.VarChar
  dpcurrent9      String?     @db.VarChar
  dpcurrent10     String?     @db.VarChar
  user_id         Int?
  created_at      DateTime    @db.Timestamp(6)
  updated_at      DateTime    @db.Timestamp(6)
  proj_year       Int?
  users           LegacyUser? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_66fd51ddb2")

  @@index([user_id], map: "index_preseason_reports_on_user_id")
  @@map("preseason_reports")
}

model LegacyResponse {
  id         Int         @id @default(autoincrement())
  reply      String?
  user_id    Int?
  post_id    Int?
  created_at DateTime    @db.Timestamp(6)
  updated_at DateTime    @db.Timestamp(6)
  posts      LegacyPost? @relation(fields: [post_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_06456afde5")
  users      LegacyUser? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_2bd9a0753e")

  @@index([post_id], map: "index_responses_on_post_id")
  @@index([user_id], map: "index_responses_on_user_id")
  @@map("responses")
}

model LegacyReview {
  id         Int         @id @default(autoincrement())
  user_id    Int?
  book_id    Int?
  thoughts   String?
  created_at DateTime    @db.Timestamp(6)
  updated_at DateTime    @db.Timestamp(6)
  users      LegacyUser? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_74a66bd6c5")
  books      LegacyBook? @relation(fields: [book_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_924a0b30ca")

  @@index([book_id], map: "index_reviews_on_book_id")
  @@index([user_id], map: "index_reviews_on_user_id")
  @@map("reviews")
}

model LegacySchemaMigration {
  version String @unique(map: "unique_schema_migrations") @db.VarChar

  @@map("schema_migrations")
}

model LegacySidebet {
  id         Int      @id @default(autoincrement())
  over       String?  @db.VarChar
  under      String?  @db.VarChar
  bet_info   String?
  stakes     String?  @db.VarChar
  created_at DateTime @db.Timestamp(6)
  updated_at DateTime @db.Timestamp(6)
  winner     String?  @db.VarChar

  @@map("sidebets")
}

model LegacyTransaction {
  id                Int           @id @default(autoincrement())
  team_after        String?       @db.VarChar
  league_after      String?       @db.VarChar
  user_id           Int?
  player_id         Int?
  created_at        DateTime      @db.Timestamp(6)
  updated_at        DateTime      @db.Timestamp(6)
  league_before     String?       @db.VarChar
  team_before       String?       @db.VarChar
  player_first_name String?       @db.VarChar
  player_last_name  String?       @db.VarChar
  details           String?
  users             LegacyUser?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_77364e6416")
  players           LegacyPlayer? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_bfd36cb507")

  @@index([player_id], map: "index_transactions_on_player_id")
  @@index([user_id], map: "index_transactions_on_user_id")
  @@map("transactions")
}

model LegacyUser {
  id                Int                     @id @default(autoincrement())
  name              String?                 @db.VarChar
  email             String?                 @db.VarChar
  team              String?                 @db.VarChar
  password_digest   String?                 @db.VarChar
  created_at        DateTime                @db.Timestamp(6)
  updated_at        DateTime                @db.Timestamp(6)
  remember_digest   String?                 @db.VarChar
  a                 String?                 @db.VarChar
  aa                String?                 @db.VarChar
  aaa               String?                 @db.VarChar
  about             String?
  admin             Boolean?                @default(false)
  glctac            Boolean?                @default(false)
  varnum            Boolean?                @default(false)
  commish           Boolean?                @default(false)
  players           LegacyPlayer[]
  posts             LegacyPost[]
  preseason_reports LegacyPreseasonReport[]
  responses         LegacyResponse[]
  reviews           LegacyReview[]
  transactions      LegacyTransaction[]

  @@index([team], map: "index_users_on_team")
  @@map("users")
}

// ==========================================
// ====== THE MODERN ERA (2026 & BEYOND) ====
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  role             Role    @default(OWNER)
  isBookClubMember Boolean @default(false)

  accounts Account[]
  sessions Session[]

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  isPrimaryManager Boolean @default(false)

  tradeApprovals TradeApproval[]
  tradeComments  TradeComment[]

  announcements   Announcement[]
  leagueDocuments LeagueDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

enum Role {
  ADMIN
  COMMISH
  OWNER
}

model Team {
  id      String  @id @default(cuid())
  name    String  @unique
  logoUrl String?
  motto   String?
  lastStatSync     DateTime?

  aaaAffiliateName String?
  aaAffiliateName  String?
  aAffiliateName   String?

  aaaLogoUrl String?
  aaLogoUrl  String?
  aLogoUrl   String?

  requireCoManagerApproval Boolean @default(false)

  managers      User[]
  players       Player[]
  originalPicks DraftPick[] @relation("OriginalPicks")
  currentPicks  DraftPick[] @relation("CurrentPicks")

  assetsSent     TradeAsset[] @relation("AssetsSent")
  assetsReceived TradeAsset[] @relation("AssetsReceived")

  transactions Transaction[]
  standings    SeasonStanding[]
  hallOfFame TeamHallOfFame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Player {
  id        String @id @default(cuid())
  legacyId  Int?   @unique
  firstName String
  lastName  String

  // External IDs for API Syncing
  fangraphsId String? @unique
  yahooId     String? @unique

  birthdate DateTime?

  // ⚾ MLB API Integration Fields
  mlbId         Int?    @unique
  mlbRawData    Json?
  
  // 📈 High-Performance Scouting Fields
  prospectRank   Int?
  isTop100       Boolean  @default(false)
  prospectEta    String? 

  isTradeLocked Boolean @default(false) // True if currently in a PENDING trade

  // Relations
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  // Many-to-Many with Positions
  positions Position[]

  level  Level?
  status Status @default(ACTIVE)
  il60UnlockDate  DateTime?

  draftPicks   DraftPick[]
  prospectRankings ProspectRanking[]
  transactions Transaction[]
  tradeAssets  TradeAsset[]
  hallOfFame TeamHallOfFame[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Position {
  id      String   @id @default(cuid())
  name    String   @unique // "Shortstop"
  abbrev  String   @unique // "SS"
  mlbCode String?
  players Player[]
}

enum Level {
  MLB
  AAA
  AA
  A
}

enum Status {
  ACTIVE
  IL
  IL_60
  NA
  SUSPENDED
  RETIRED
}

model DraftPick {
  id         String @id @default(cuid())
  year       Int
  round      Int
  pickNumber Int?

  isTradeLocked Boolean @default(false) // True if currently in a PENDING trade

  originalOwnerId String
  currentOwnerId  String

  originalOwner Team @relation("OriginalPicks", fields: [originalOwnerId], references: [id])
  currentOwner  Team @relation("CurrentPicks", fields: [currentOwnerId], references: [id])

  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])

  pickTime DateTime?

  season      Season       @relation(fields: [year], references: [year])
  tradeAssets TradeAsset[]

  transactions   Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model Trade {
  id               String      @id @default(cuid())
  status           TradeStatus @default(PENDING)
  initiatingTeamId String

  aiAnalysis Json?
  expiresAt  DateTime?

  approvals TradeApproval[]
  assets    TradeAsset[]
  comments  TradeComment[]
  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TradeAsset {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  fromTeamId String
  toTeamId   String

  // Wire up the relations so Prisma can fetch the team data
  fromTeam Team @relation("AssetsSent", fields: [fromTeamId], references: [id])
  toTeam   Team @relation("AssetsReceived", fields: [toTeamId], references: [id])

  fromTeamNameSnapshot String?
  toTeamNameSnapshot   String?
  playerNameSnapshot   String?
  pickNameSnapshot     String? // e.g., "2027 1st Round Pick (Bridge Four)"

  // An asset can be a player OR a draft pick
  playerId String?
  player   Player? @relation(fields: [playerId], references: [id])

  draftPickId String?
  draftPick   DraftPick? @relation(fields: [draftPickId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TradeComment {
  id      String @id @default(cuid())
  tradeId String
  userId  String
  content String @db.Text

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TradeApproval {
  id      String         @id @default(cuid())
  tradeId String
  userId  String
  status  ApprovalStatus @default(PENDING)

  correspondingMoves Json?

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tradeId, userId])
}

enum TradeStatus {
  PENDING
  APPROVED
  VETOED
  PROCESSED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Transaction {
  id       String    @id @default(cuid())
  type     TransType

  playerId String?
  player   Player?    @relation(fields: [playerId], references: [id])

  draftPickId String?
  draftPick   DraftPick? @relation(fields: [draftPickId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  tradeId     String?   
  trade       Trade?    @relation(fields: [tradeId], references: [id])

  details   String?
  createdAt DateTime @default(now())
}

enum TransType {
  ADD
  DROP
  TRADE
  DRAFT
  PROMOTE
  DEMOTE
  PLACE_ON_IL
  ACTIVATE_FROM_IL
  PLACE_ON_IL_60
  ACTIVATE_FROM_IL_60
  PLACE_ON_NA
  ACTIVATE_FROM_NA
  RETIRE
  UNRETIRE
}

model Season {
  year              Int     @id
  ffblChampion      String
  playoffMvp        String
  regularSeasonBest String
  alChamp           String?
  nlChamp           String?
  mlbMvp            String
  mlbCyYoung        String
  mlbRoy            String

  standings  SeasonStanding[]
  draftPicks DraftPick[]

  updatedAt DateTime @updatedAt
}

model SeasonStanding {
  id     String @id @default(cuid())
  year   Int
  season Season @relation(fields: [year], references: [year])

  teamId   String
  team     Team   @relation(fields: [teamId], references: [id]) // NEW: Wired up the relation
  teamName String
  rank     Int

  wins   Int
  losses Int
  ties   Int    @default(0)
  pct    Float?

  isPlayoffTeam Boolean @default(false)
}

model LeagueSettings {
  id                  Int       @id @default(1)
  enforceRosterLimits Boolean   @default(true)
  
  currentSeason       Int       @default(2026) 
  isDraftOpen         Boolean   @default(false) 
  tradeDeadline       DateTime? 

  // Active Roster Limits
  mlbLimit Int @default(25)
  aaaLimit Int @default(6)
  aaLimit  Int @default(6)
  aLimit   Int @default(6)

  // Stash / Injured Limits
  ilLimit   Int  @default(5)
  il60Limit Int? 
  naLimit   Int  @default(2)

  updatedAt DateTime @updatedAt
}

model TeamHallOfFame {
  id            String   @id @default(cuid())
  teamId        String
  playerId      String
  inductionYear Int
  blurb         String?  @db.Text // @db.Text allows for longer, paragraph-style memories

  team          Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
}

model ProspectRanking {
  id        String   @id @default(cuid())
  playerId  String
  year      Int
  rank      Int
  eta       String?
  scouting  Json?

  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([playerId, year])
  @@index([playerId])
  @@index([year])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false) 
  
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LeagueRecord {
  id           String     @id @default(cuid())
  type         RecordType // Enum: TEAM or INDIVIDUAL
  title        String     // e.g., "Most HRs in a Season"
  recordHolder String     // e.g., "Aaron Judge" or "Bridge Four"
  value        String     // e.g., "62" or "120-42"
  yearSet      Int?       // e.g., 2022
  description  String?    @db.Text

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum RecordType {
  TEAM
  INDIVIDUAL
}

model LeagueDocument {
  id          String   @id @default(cuid())
  slug        String   @unique // e.g., "history-hub", "league-rules"
  title       String   
  content     String   @db.Text
  
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
