generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ====== THE QUARANTINE (2015-2025) ========
// ==========================================

model LegacyBook {
  id         Int            @id @default(autoincrement())
  selector   String?        @db.VarChar
  title      String?        @db.VarChar
  author     String?        @db.VarChar
  summary    String?
  start      DateTime?      @db.Date
  end        DateTime?      @db.Date
  created_at DateTime       @db.Timestamp(6)
  updated_at DateTime       @db.Timestamp(6)
  reviews    LegacyReview[]

  @@map("books")
}

model LegacyCommishNote {
  id                   Int      @id @default(autoincrement())
  commish_note_content String?
  created_at           DateTime @db.Timestamp(6)
  updated_at           DateTime @db.Timestamp(6)

  @@map("commish_notes")
}

model LegacyLevel {
  id         Int            @id @default(autoincrement())
  league     String?        @db.VarChar
  player_id  Int?
  created_at DateTime       @db.Timestamp(6)
  updated_at DateTime       @db.Timestamp(6)
  players    LegacyPlayer[]

  @@map("levels")
}

model LegacyPlayerType {
  id         Int           @id @default(autoincrement())
  kind       String?       @db.VarChar
  player_id  Int?
  created_at DateTime      @db.Timestamp(6)
  updated_at DateTime      @db.Timestamp(6)
  players    LegacyPlayer? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_b5f8c04bc8")

  @@map("player_types")
}

model LegacyPlayer {
  id           Int                 @id @default(autoincrement())
  user_id      Int?
  level_id     Int?
  last_name    String?             @db.VarChar
  first_name   String?             @db.VarChar
  dob          DateTime?           @db.Date
  retro        DateTime?           @db.Date
  activate     DateTime?           @db.Date
  created_at   DateTime            @db.Timestamp(6)
  updated_at   DateTime            @db.Timestamp(6)
  position_id  Int?
  trade_info   String?
  affiliation  String?             @db.VarChar
  player_note  String?
  player_types LegacyPlayerType[]
  users        LegacyUser?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_224cac07ce")
  levels       LegacyLevel?        @relation(fields: [level_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_a986decdfd")
  positions    LegacyPosition[]
  transactions LegacyTransaction[]

  @@index([level_id], map: "index_players_on_level_id")
  @@index([user_id], map: "index_players_on_user_id")
  @@map("players")
}

model LegacyPosition {
  id         Int           @id @default(autoincrement())
  player_id  Int?
  spot       String?       @db.VarChar
  created_at DateTime      @db.Timestamp(6)
  updated_at DateTime      @db.Timestamp(6)
  players    LegacyPlayer? @relation(fields: [player_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_8691b6d8ec")

  @@index([player_id], map: "index_positions_on_player_id")
  @@map("positions")
}

model LegacyPost {
  id          Int              @id @default(autoincrement())
  topic       String?          @db.VarChar
  content     String?
  user_id     Int?
  created_at  DateTime         @db.Timestamp(6)
  updated_at  DateTime         @db.Timestamp(6)
  most_recent DateTime?        @db.Timestamp(6)
  users       LegacyUser?      @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_rails_5b5ddfd518")
  responses   LegacyResponse[]

  @@index([user_id], map: "index_posts_on_user_id")
  @@map("posts")
}

model LegacyPreseasonReport {
